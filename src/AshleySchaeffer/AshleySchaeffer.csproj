<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <Version>4.1.0</Version>
    <Authors>AshleySchaefferBMW</Authors>
    <RootNamespace>AshleySchaeffer</RootNamespace>
    <AssemblyName>AshleySchaeffer</AssemblyName>

    <OutputPath>bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- SPT 4.1 ships as SPTushonka.*; the assemblies inside are still named SPTarkov.*. -->
    <PackageReference Include="SPTushonka.Common" Version="4.1.5" />
    <PackageReference Include="SPTushonka.DI" Version="4.1.5" />
    <PackageReference Include="SPTushonka.Server.Core" Version="4.1.5" />
  </ItemGroup>

  <!--
    The JSON/bundle payload lives in mod/ at the repo root so it can be diffed without wading
    through build output. Copy it next to the dll so the layout the mod reads at runtime
    (config.json, db/..., res/...) is what ends up in the output folder.
  -->
  <ItemGroup>
    <None Include="..\..\mod\**\*" LinkBase="" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Drop the built mod into the server's user\mods folder.
    Windows-only, because SptModsDir is a Windows path: a Linux/CI build would otherwise create a
    directory literally named "E:\SPT 4.1\..." in the repo. Pass -p:OS=Windows_NT to force it.
    Skip with -p:SkipDeploy=true when the server is running and holding the dll open.
  -->
  <PropertyGroup>
    <SptRoot Condition="'$(SptRoot)' == '' And '$(SPT_ROOT)' != ''">$(SPT_ROOT)</SptRoot>
    <SptRoot Condition="'$(SptRoot)' == ''">E:\SPT 4.1</SptRoot>
    <SptModsDir Condition="'$(SptModsDir)' == ''">$(SptRoot)\SPT_Runtime\user\mods</SptModsDir>
  </PropertyGroup>

  <Target Name="DeployToSpt" AfterTargets="Build"
          Condition="'$(OS)' == 'Windows_NT' AND '$(SkipDeploy)' != 'true'">
    <PropertyGroup>
      <ModDeployDir>$(SptModsDir)\AshleySchaeffer\</ModDeployDir>
    </PropertyGroup>
    <ItemGroup>
      <DeployPayload Include="$(OutputPath)**\*" Exclude="$(OutputPath)**\*.pdb;$(OutputPath)**\*.deps.json" />
    </ItemGroup>
    <MakeDir Directories="$(ModDeployDir)" />
    <!-- Never overwrite a config the player has edited. -->
    <Copy SourceFiles="@(DeployPayload)" DestinationFiles="@(DeployPayload->'$(ModDeployDir)%(RecursiveDir)%(Filename)%(Extension)')"
          Condition="'%(Filename)%(Extension)' != 'config.json'"
          SkipUnchangedFiles="false" ContinueOnError="WarnAndContinue" />
    <Copy SourceFiles="$(OutputPath)config.json" DestinationFolder="$(ModDeployDir)"
          Condition="!Exists('$(ModDeployDir)config.json')" ContinueOnError="WarnAndContinue" />
    <Message Text="Deployed $(TargetFileName) to $(ModDeployDir)" Importance="high" />
  </Target>

</Project>
